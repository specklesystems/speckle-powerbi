# Supply-chain hardening via https://cooldowns.dev/
# Only install npm versions that have been published for at least 7 days,
# giving the ecosystem time to detect and yank compromised releases.
# Requires npm >= 11.10.0 (see `packageManager` in package.json).
min-release-age=7
# @speckle packages resolve from Speckle's private tailnet registry (requires Tailscale up).
# They are first-party and often consumed the day they are cut, so they are exempt from the
# public-registry cooldown above.
@speckle:registry=https://npmregistry.mermaid-emperor.ts.net
min-release-age-exclude[]=@speckle/*
