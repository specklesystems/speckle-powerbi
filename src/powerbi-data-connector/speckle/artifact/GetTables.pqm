// ARTIFACT PATH — the 4.0 star-schema pipeline behind Speckle.GetTables
// (ENG-9165). Reads artifact bundles only: versions without a bundle are NOT
// adapted from their JSON representation; they error towards Speckle.GetByUrl.
// Returns the star-schema navigation table.
(url as text) as table =>
    let
        // single source of truth for the connector version (keep Speckle.pq [Version]
        // and Speckle.proj <Version> aligned with this)
        ConnectorVersion = "4.0.0",

        // the logic for importing functions from other files — this is the single
        // copy; leaf modules receive what they need via the deps record
        Extension.LoadFunction = (fileName as text) =>
            let
                binary = Extension.Contents(fileName),
                asText = Text.FromBinary(binary)
            in
                try
                    Expression.Evaluate(asText, #shared)
                catch (e) =>
                    error
                        [
                            Reason = "Extension.LoadFunction Failure",
                            Message.Format = "Loading '#{0}' failed - '#{1}': '#{2}'",
                            Message.Parameters = {fileName, e[Reason], e[Message]},
                            Detail = [File = fileName, Error = e]
                        ],

        Parser = Extension.LoadFunction("Parser.pqm"),
        CheckPermissions = Extension.LoadFunction("CheckPermissions.pqm"),
        GetUser = Extension.LoadFunction("GetUser.pqm"),
        GetWorkspace = Extension.LoadFunction("GetWorkspace.pqm"),
        ExchangeToken = Extension.LoadFunction("ExchangeToken.pqm"),
        GetModel = Extension.LoadFunction("GetModel.pqm"),
        FetchArtifacts = Extension.LoadFunction("FetchArtifacts.pqm"),
        ReadBundleTable = Extension.LoadFunction("ReadBundleTable.pqm"),
        GetEavModel = Extension.LoadFunction("GetEavModel.pqm"),
        NavigationTable = Extension.LoadFunction("NavigationTable.pqm"),
        AddProperties = Extension.LoadFunction("AddProperties.pqm"),
        BuildNavigation = Extension.LoadFunction("BuildNavigation.pqm"),
        EncodeUserInfo = Extension.LoadFunction("EncodeUserInfo.pqm"),
        MarkReceived = Extension.LoadFunction("MarkReceived.pqm"),
        ProjectModels = Extension.LoadFunction("Project.Models.pqm"),

        deps = [ReadBundleTable = ReadBundleTable],

        // federated models namespace their dense-int keys as ordinal * 2^32 + index
        KeySpace = 4294967296,

        // M is lazy: a side-effecting call only executes if its result is observed.
        // Observe(sideEffect, value) evaluates sideEffect and returns value.
        Observe = (sideEffect as any, value as any) as any =>
            if sideEffect = null then value else value,

        ProjectWideModelLimit = 10000,

        // parse the URL to determine load shape
        parsedUrl = Parser(url),

        expandedResourceIdString = if parsedUrl[isProjectWideModelLoad] then
            Text.Combine(ProjectModels(parsedUrl[baseUrl], parsedUrl[projectId], ProjectWideModelLimit), ",")
        else
            parsedUrl[resourceIdString],

        effectiveUrl = if parsedUrl[isProjectWideModelLoad] then
            Text.Combine({
                parsedUrl[baseUrl],
                "/projects/",
                parsedUrl[projectId],
                "/models/",
                expandedResourceIdString
            })
        else
            url,

        effectiveParsedUrl = Parser(effectiveUrl),

        metadataUrl = if parsedUrl[isProjectWideModelLoad] then url else effectiveUrl,

        // single permission guard
        permissionCheck = CheckPermissions(metadataUrl),
        permissionGuard = if not Record.HasFields(permissionCheck, {"authorized", "code", "message"}) then
            error "Invalid permission check result"
        else if not permissionCheck[authorized] then
            error Text.Format(
                "Permission denied: #{0} (Error code: #{1})",
                {permissionCheck[message], permissionCheck[code]}
            )
        else
            null,

        // user / workspace context + the single token exchange
        userInfo = GetUser(metadataUrl),
        powerfulToken = userInfo[Token],
        userEmail = userInfo[UserEmail],
        workspaceInfo = GetWorkspace(metadataUrl),

        tokenExchangeResult = ExchangeToken(
            powerfulToken,
            {"profile:read", "streams:read", "users:read"},
            effectiveParsedUrl[projectId],
            effectiveParsedUrl[baseUrl],
            effectiveParsedUrl[resourceIdString]
        ),

        // hard-fail if token exchange failed - do NOT use powerful token as fallback
        weakToken = if tokenExchangeResult[Success] then
            tokenExchangeResult[Token]
        else
            error [
                Reason = "TokenExchangeFailed",
                Message.Format = "Failed to exchange token for limited scope token: #{0}",
                Message.Parameters = {tokenExchangeResult[ErrorMessage]},
                Detail = [
                    ErrorMessage = tokenExchangeResult[ErrorMessage],
                    ProjectId = effectiveParsedUrl[projectId],
                    ServerUrl = effectiveParsedUrl[baseUrl]
                ]
            ],

        // representation guard: this path reads artifact bundles only — a version
        // without one is never adapted from its JSON representation. The
        // rootObjectId probe (version.referencedObject) only tells "JSON-only"
        // apart from "no data at all" for the error message.
        ArtifactUnavailableError = (modelInfo as record, projectId as text, baseUrl as text) as any =>
            if modelInfo[rootObjectId] <> null then
                error [
                    Reason = "ArtifactBundleUnavailable",
                    Message.Format = "Model '#{0}' (version #{1}) has no 4.0 artifact bundle: it was published with a pre-4.0 connector. Load it with Speckle.GetByUrl(url) and the legacy Speckle visual, or republish the model with a 4.0 connector to get star-schema tables.",
                    Message.Parameters = {modelInfo[modelName], modelInfo[versionId]},
                    Detail = [
                        ModelId = modelInfo[modelId],
                        VersionId = modelInfo[versionId],
                        ProjectId = projectId,
                        Server = baseUrl
                    ]
                ]
            else
                error [
                    Reason = "DataUnavailable",
                    Message.Format = "Model '#{0}' (version #{1}) has no loadable data: the server reports neither a 4.0 artifact bundle nor a JSON representation for this version.",
                    Message.Parameters = {modelInfo[modelName], modelInfo[versionId]},
                    Detail = [
                        ModelId = modelInfo[modelId],
                        VersionId = modelInfo[versionId],
                        ProjectId = projectId,
                        Server = baseUrl
                    ]
                ],

        // loads one model and returns its star-schema shapes + per-model metadata
        ProcessSingleModel = (baseUrl as text, projectId as text, modelId as text, versionId as nullable text, ordinal as number) as record =>
            let
                singleModelUrl = Text.Combine({
                    baseUrl,
                    "/projects/",
                    projectId,
                    "/models/",
                    modelId,
                    if versionId <> null then Text.Combine({"@", versionId}) else ""
                }),

                modelInfo = GetModel(singleModelUrl),
                resolvedVersionId = if versionId <> null then versionId else modelInfo[versionId],

                // null -> no artifact bundle for this version (JSON-only or empty)
                files = FetchArtifacts(baseUrl, projectId, modelInfo[modelId], resolvedVersionId, weakToken),

                model = if files <> null then
                    GetEavModel(deps, files, ordinal * KeySpace)
                else
                    ArtifactUnavailableError(modelInfo, projectId, baseUrl),

                // best-effort receipt tracking (forced via Observe below)
                markReceivedResult = try MarkReceived(powerfulToken, resolvedVersionId, projectId, baseUrl) otherwise false,

                userInfoData = [
                    schemaVersion = 2,
                    pipeline = "artifact",
                    server = baseUrl,
                    projectId = projectId,
                    modelId = modelInfo[modelId],
                    versionId = resolvedVersionId,
                    token = weakToken,
                    workspaceId = workspaceInfo[workspaceId],
                    workspaceName = workspaceInfo[workspaceName],
                    // workspaceLogo deliberately NOT in the blob: logos are base64
                    // data-URIs (tens of KB) and the blob repeats on EVERY data row —
                    // the visual fetches the logo itself via GraphQL using workspaceId
                    canHideBranding = workspaceInfo[canHideBranding],
                    sourceApplication = modelInfo[sourceApplication],
                    version = ConnectorVersion,
                    email = userEmail
                ],

                encodedUserInfo = Observe(markReceivedResult, EncodeUserInfo(userInfoData))
            in
                [
                    Model = model,
                    VersionId = resolvedVersionId,
                    // pinned federated entries stay distinguishable per version
                    SourceLabel = if versionId <> null then
                        Text.Combine({modelInfo[modelName], "-", versionId})
                    else
                        modelInfo[modelName],
                    EncodedUserInfo = encodedUserInfo
                ],

        // combines per-model tables and assembles the navigation table.
        // Recommended PBI relationships: Objects 1-* Properties *-1 Property Paths
        // on object_key / path_key, plus Objects *-1 Models on model_key —
        // Power BI cannot compose row groupings from unrelated tables, so the
        // visual's Models[Model Info] parent grouping needs that relationship
        // (Desktop's autodetect finds it: matching names, unique one side).
        BuildResult = (modelsData as list, addSourceModel as logical) as table =>
            let
                // delimiter chosen to avoid conflicts with base64 characters;
                // the concatenation order is a correctness invariant — it must
                // match the federation ordinal that namespaces object_key
                combinedBlobs = Text.Combine(List.Transform(modelsData, each [EncodedUserInfo]), "|||"),

                CombinePart = (getPart as function, withSource as logical) as table =>
                    Table.Combine(
                        List.Transform(
                            modelsData,
                            (m) =>
                                let
                                    t = getPart(m[Model])
                                in
                                    if withSource and addSourceModel then
                                        Table.AddColumn(t, "Source Model", (row) => m[SourceLabel], type text)
                                    else
                                        t
                        )
                    ),

                // model_key is a CONSTANT 1 on every row of both tables: it
                // exists only to carry the Objects *-1 Models relationship.
                // A constant int column value-encodes to almost nothing in
                // VertiPaq — unlike the ~1KB blob it replaces per row.
                objectsT = Table.AddColumn(
                    CombinePart((mm) => mm[Objects], true),
                    "model_key",
                    each 1,
                    Int64.Type
                ),
                // the whole per-load payload lives in this ONE visible row —
                // repeating it on every Objects row was the dominant term in
                // the visual host's fetchMoreData memory ceiling
                modelsT = #table(
                    type table [#"Model Info" = text, model_key = Int64.Type],
                    {{combinedBlobs, 1}}
                ),
                propertiesT = CombinePart((mm) => mm[Properties], false),
                pathsT = CombinePart((mm) => mm[Paths], false),
                objectTypesT = CombinePart((mm) => mm[ObjectTypes], false),
                typePropertiesT = CombinePart((mm) => mm[TypeProperties], false)
            in
                // The Navigator lists Objects, Models, Property Paths and the
                // model-bound ExpandProperties function. The three hidden rows
                // stay in the table — Speckle.AddProperties and
                // Speckle.AddAllProperties index all five star-schema keys.
                BuildNavigation(
                    [NavigationTable = NavigationTable, AddProperties = AddProperties],
                    [
                        Objects = objectsT,
                        Models = modelsT,
                        Properties = propertiesT,
                        Paths = pathsT,
                        ObjectTypes = objectTypesT,
                        TypeProperties = typePropertiesT
                    ]
                ),

        results = Observe(
            permissionGuard,
            if effectiveParsedUrl[isFederated] = true then
                let
                    feds = effectiveParsedUrl[federatedModels],
                    modelsData = List.Transform(
                        List.Positions(feds),
                        (i) => ProcessSingleModel(
                            effectiveParsedUrl[baseUrl],
                            effectiveParsedUrl[projectId],
                            feds{i}[modelId],
                            feds{i}[versionId],
                            i
                        )
                    )
                in
                    BuildResult(modelsData, true)
            else
                BuildResult(
                    {
                        ProcessSingleModel(
                            effectiveParsedUrl[baseUrl],
                            effectiveParsedUrl[projectId],
                            effectiveParsedUrl[modelId],
                            effectiveParsedUrl[versionId],
                            0
                        )
                    },
                    false
                )
        )
    in
        results
