// Adds every property path in the passed Property Paths table. AddProperties
// remains the single implementation of validation, naming, and source-split
// column emission (instance values unprefixed, type values Type_-prefixed);
// useFullPaths is forwarded to it unchanged. The path list is intentionally
// not deduplicated here — federated models repeat identical path text under
// per-source path_keys and AddProperties owns the dedup.
(
    objects as table,
    propertyValues as table,
    paths as table,
    objectTypes as table,
    typeProperties as table,
    optional useFullPaths as nullable logical
) as table =>
    Speckle.AddProperties(
        objects, propertyValues, paths, objectTypes, typeProperties,
        Table.Column(paths, "Property"), useFullPaths
    )
