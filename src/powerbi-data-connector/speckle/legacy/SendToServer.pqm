// LEGACY PATH — reads the version's JSON representation only (ENG-9165).
// Downloads the raw object tree from {server}/objects/{projectId}/{rootObjectId}.
// The caller passes the already-exchanged weak token; when omitted (direct use of
// the shared export), the current credential's access token is used.
(url as text, optional token as text) as list =>
    let
        GetModel = Extension.LoadFunction("GetModel.pqm"),
        Parser = Extension.LoadFunction("Parser.pqm"),

        // helper function to load .pqm modules dynamically
        Extension.LoadFunction = (fileName as text) =>
            let
                binary = Extension.Contents(fileName),
                asText = Text.FromBinary(binary)
            in
                try
                    Expression.Evaluate(asText, #shared)
                catch (e) =>
                    error
                        [
                            Reason = "Extension.LoadFunction Failure",
                            Message.Format = "Loading '#{0}' failed - '#{1}': '#{2}'",
                            Message.Parameters = {fileName, e[Reason], e[Message]},
                            Detail = [File = fileName, Error = e]
                        ],

        modelInfo = GetModel(url),
        parsedUrl = Parser(url),

        tokenToUse = if token <> null then
            token
        else
            let
                credentialToken = try Extension.CurrentCredential()[access_token] otherwise null
            in
                if credentialToken <> null then
                    credentialToken
                else
                    error [
                        Reason = "MissingToken",
                        Message = "No token supplied and no credential available for the object download."
                    ],

        // versions without a JSON representation (4.0 artifact-only) have no
        // root object to download — fail clearly instead of building a bad URL
        rootObjectId = if modelInfo[rootObjectId] <> null then
            modelInfo[rootObjectId]
        else
            error [
                Reason = "JsonRepresentationUnavailable",
                Message.Format = "Model '#{0}' (version #{1}) has no JSON representation to download. Load it with Speckle.GetTables(url) and use the Speckle 4.0 visual instead.",
                Message.Parameters = {modelInfo[modelName], modelInfo[versionId]},
                Detail = [
                    ModelId = modelInfo[modelId],
                    VersionId = modelInfo[versionId],
                    ProjectId = parsedUrl[projectId],
                    Server = parsedUrl[baseUrl]
                ]
            ],

        // downloads data directly from server
        DirectDownload = (downloadToken as text) =>
            let
                objectUrl = Text.Combine({
                    parsedUrl[baseUrl],
                    "/objects/",
                    parsedUrl[projectId],
                    "/",
                    rootObjectId
                }),

                Response = Web.Contents(
                    objectUrl,
                    [
                        Headers = [
                            #"Authorization" = "Bearer " & downloadToken,
                            #"Accept" = "application/json"
                        ],
                        ManualStatusHandling = {400, 401, 403, 404, 500, 502, 503, 504}
                    ]
                ),

                StatusCode = Value.Metadata(Response)[Response.Status],

                JsonResponse = if StatusCode >= 200 and StatusCode < 300 then
                    Json.Document(Response)
                else
                    error [
                        Reason = "DirectDownloadFailed",
                        Message.Format = "Failed to download model data from Speckle server (Status: #{0})",
                        Message.Parameters = {Text.From(StatusCode)},
                        Detail = [
                            StatusCode = StatusCode,
                            ObjectUrl = objectUrl,
                            ProjectId = parsedUrl[projectId],
                            RootObjectId = rootObjectId
                        ]
                    ]
            in
                JsonResponse,

        FinalResult = DirectDownload(tokenToUse)
    in
        FinalResult
